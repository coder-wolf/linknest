# Copy to .env and fill in real values.
DATABASE_URL="postgresql://USER@localhost:5432/linknest?schema=public"

# Generate with: openssl rand -base64 32
AUTH_SECRET="replace-me"

# Transactional email (Resend). Verify linknest.online in Resend, then set the
# API key and a sender on that domain.
RESEND_API_KEY=""
EMAIL_FROM="LinkNest <hello@linknest.online>"
EMAIL_REPLY_TO=""

# Public origin used for canonical URLs, Open Graph tags and share links.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Vercel Blob stores profile photo uploads. Connect a Blob store to the
# project (Storage → Blob) and copy its read-write token.
BLOB_READ_WRITE_TOKEN=""

# Lemon Squeezy payments. Create a store, a subscription product for each paid
# plan, then copy the store, variant and API values from Settings → API.
LEMONSQUEEZY_API_KEY=""
LEMONSQUEEZY_STORE_ID=""
LEMONSQUEEZY_VARIANT_PRO=""
LEMONSQUEEZY_VARIANT_BUSINESS=""
# Signing secret from Settings → Webhooks. Point the webhook at
# ${NEXT_PUBLIC_APP_URL}/api/webhooks/lemonsqueezy
LEMONSQUEEZY_WEBHOOK_SECRET=""
